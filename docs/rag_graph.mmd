---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	retrieve(retrieve)
	route(route)
	answer_standard(answer_standard)
	answer_complex(answer_complex)
	__end__([<p>__end__</p>]):::last
	__start__ --> retrieve;
	retrieve --> route;
	route -.-> answer_complex;
	route -.-> answer_standard;
	answer_complex --> __end__;
	answer_standard --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
