    "id": "EQ2-07",
    "question": "What protections apply to a privileged administrator who works remotely?",
    "route": "complex",
    "route_reason": "complex phrase: protections",
    "model": "google/gemini-3.7-flash",
    "top_score": 0.41720762495714286,
